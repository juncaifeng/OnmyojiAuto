{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OnmyojiAuto",
  "version": "2.3.4",
  "identifier": "com.rmamun.onmyojiauto",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      { "title": "OnmyojiAuto", "width": 1180, "height": 780, "minWidth": 940, "minHeight": 640, "resizable": true }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost http://127.0.0.1:* ws://127.0.0.1:*; img-src 'self' data: blob: http://127.0.0.1:*; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "externalBin": ["binaries/oat-backend"],
    "windows": { "nsis": { "installMode": "perMachine", "displayLanguageSelector": false } }
  }
}
